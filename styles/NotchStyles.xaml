<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Apple Dynamic Island 순정 Jet Black 스타일
         - 칠흑 같은 올레드 블랙 (#0C0C0E)
         - 정밀한 서브밀리 1px 림 하이라이트
         - 부드러운 깊이감의 앰비언트 섀도우
         ============================================================ -->
    <Style x:Key="DarkNotchStyle" TargetType="Border">
        <Setter Property="Background" Value="#0C0C0E"/>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#24FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
                    <GradientStop Color="#04FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="8" Opacity="0.55" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
