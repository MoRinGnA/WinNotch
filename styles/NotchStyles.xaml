<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         다크 모드: 기존에 완성했던 불투명 플랫 배경 (그대로 보존)
         ============================================================ -->
    <Style x:Key="DarkNotchStyle" TargetType="Border">
        <Setter Property="Background" Value="#0A0A0A"/>
        <Setter Property="BorderBrush" Value="#25FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="19"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.5" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         리퀴드 글래스 모드 (Layer 1: Base Glass)
         블로그의 bg-white/[0.04] backdrop-blur-xl 를 WPF로 옮긴 버전.
         WPF는 배경 자체를 실시간 blur-behind 할 수 없어서(진짜 Acrylic은
         DWM composition API가 필요) 대신 반투명 그라데이션 베이스로
         "젖빛 유리" 느낌을 근사한다. 위쪽이 살짝 밝고 아래로 갈수록
         짙어지는 것 자체가 이미 약한 Fresnel을 겸함.
         나머지 레이어(Fresnel/Inset Border/Dynamic Light)는
         MainWindow.xaml의 GlassOverlayLayers 에서 별도 오버레이로 쌓는다.
         ============================================================ -->
<Style x:Key="LiquidGlassNotchStyle" TargetType="Border">
    <Setter Property="Background">
        <Setter.Value>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#59323234" Offset="0.0"/>
                <GradientStop Color="#4D1C1C1E" Offset="0.15"/>
                <GradientStop Color="#E8121214" Offset="1.0"/>
            </LinearGradientBrush>
        </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="19"/>
    <Setter Property="Effect">
        <Setter.Value>
            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="8" Opacity="0.5" Direction="270"/>
        </Setter.Value>
    </Setter>
</Style>

    <!-- Layer 4: Dynamic Light. 블로그의
         radial-gradient(circle at 30% 30%, rgba(255,255,255,0.12) 0%, transparent 50%)
         를 그대로 옮긴 것. RotateTransform으로 회전시키면 "빛이 흐르는" 느낌이 난다. -->
    <RadialGradientBrush x:Key="GlassLightBrush" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Color="#10FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>

</ResourceDictionary>
